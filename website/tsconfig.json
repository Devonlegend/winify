{
  // Based on @docusaurus/tsconfig (v3.8.1) but with `baseUrl` removed.
  // `baseUrl` is deprecated in TypeScript 6 (see Docusaurus #11893): the
  // inherited value resolves relative to node_modules and breaks `@site/*`,
  // while re-declaring it here triggers TS5101 in TS 6. With `baseUrl` absent,
  // `paths` resolves relative to this file (TypeScript >= 4.1).
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "exclude": ["node_modules", "build", ".docusaurus"]
}
